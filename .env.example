# Leave blank for single-process local PGlite. Production requires PostgreSQL.
# For Neon serverless deployments use the pooled hostname containing -pooler.
# Supabase: use the shared transaction pooler on port 6543 with sslmode=verify-full.
DATABASE_URL=
# Supabase requires its official root certificate PEM for full TLS verification.
DATABASE_SSL_CA=
# Set to 1 only during a database migration; API reads/writes return 503 before connecting.
MAINTENANCE_MODE=0
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://localhost:3000
# APP_MODE=demo allows unreviewed draft content. Formal mode has an audit gate.
APP_MODE=demo
